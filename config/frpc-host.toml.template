# RAC (frpc) reverse-tunnel config TEMPLATE — DASI2 site (Proxmox host).
# install-host.sh renders this to /etc/sigmond/frpc-host.toml.template with
# the site's identity and its VM's address filled in.  To ACTIVATE, get this
# site's remote port assignment from the WsprDaemon admin, then:
#   cp /etc/sigmond/frpc-host.toml.template /etc/sigmond/frpc-host.toml
#   systemctl restart sigmond-rac-host
#
# ONE login per site.  This frpc runs on the hypervisor — the machine that
# is up when the VM is not — and carries everything the site publishes:
# the host's own sshd and Proxmox VE web UI over 127.0.0.1, and the DASI2
# VM's sshd and web forwarded across the bridge to the VM's address.  A
# second frpc for the guest is NOT wanted: the gateway files one key per
# login id, so two tunnels sharing this site's id would see the second
# refused — which is the intended guard against double-arming a site.
#
# Gateway: sigmond stations tunnel to HamSCI's own server, vpn.hamsci.org,
# not to WsprDaemon's gw2.  :35736 is its frps-secure instance (TLS forced,
# trust-on-first-use auth); :35735 is the legacy open frps that the older
# HamSCI volunteer stations still use.  There is no registrar here.
#
# Identity: the gateway's TOFU plugin admits a login that carries a user id
# and a pubkey in [metadatas].  The FIRST login to claim a given user id
# files its pubkey; later logins must present the same key, so nothing else
# can take this site's identity.  The token is NOT the gate and is empty by
# design.  Re-keying a site means the admin must first delete its entry from
# the gateway registry, or the new key is refused.
#
# Services and ports: a site has ONE number (its RAC/DASI number), and each
# service it publishes gets a band whose remote port is a fleet-wide base
# plus that number — vm-ssh 35800+n, vm-web 45800+n, host-ssh 50800+n,
# host-ui 55800+n, and so on.  The band table and the list of what this site
# publishes live in config/rac-bands.sh and SIGMOND_RAC_PROXIES; adding the
# magnetometer page or a GRAPE page is one more entry there, not a change
# here.  Admins reach every port at the gateway's VPN address,
# 10.3.2.1:<port>.
# Proxy names are "<reporter ID>-<band>"; the rac-dashboard keys on those
# band suffixes to group a site's tunnels, so do not rename them.

serverAddr = "vpn.hamsci.org"
serverPort = 35736
user = "@USER@"

# Reconnect forever instead of exiting when the gateway is unreachable at
# startup.  Must stay above the first table header to be a top-level key.
loginFailExit = false

[auth]
method = "token"
token = ""

# frps-secure forces TLS.  Its certificate is self-signed and no CA is
# published, so there is no trustedCaFile to pin: TLS provides the
# encryption, and the TOFU pubkey below provides the identity.
[transport.tls]
enable = true

[metadatas]
pubkey = "@PUBKEY@"
site = "@SITE@"
dasi = "@DASI@"

[webServer]
addr = "127.0.0.1"
port = 7500

# The [[proxies]] blocks are appended here by the installer, one per
# service in this site's proxy set — see config/rac-bands.sh.
